---
import type { Dict } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import { localizedUrl } from '../../i18n/utils';

interface Props { lang: Lang; t: Dict; }
const { lang, t } = Astro.props;
/* DETAILS LATER: replace "#" with real profile URLs */
const socials = [
  { label: 'Facebook', href: '#', path: 'M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5z' },
  { label: 'YouTube', href: '#', path: 'M21 8.2a2.5 2.5 0 0 0-1.8-1.8C17.7 6 12 6 12 6s-5.7 0-7.2.4A2.5 2.5 0 0 0 3 8.2 26 26 0 0 0 2.6 12 26 26 0 0 0 3 15.8a2.5 2.5 0 0 0 1.8 1.8c1.5.4 7.2.4 7.2.4s5.7 0 7.2-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 21.4 12 26 26 0 0 0 21 8.2zM10 15V9l5.2 3L10 15z' },
  { label: 'WhatsApp', href: 'https://wa.me/237640684417', path: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm3.5 12.1c-.2.5-1 .9-1.5.9-.4 0-.9.2-3-.7-2.5-1-4-3.5-4.1-3.7-.1-.2-1-1.4-1-2.7s.6-1.9.9-2.2c.2-.2.5-.3.8-.3h.6c.2 0 .5 0 .7.6l.9 2.1c.1.2.1.4 0 .7l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.5 2 2.4 1.4 1.2 2.5 1.6 2.9 1.8.3.2.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.2z' },
  { label: 'Instagram', href: '#', path: 'M12 8.8A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8zm0-2.1a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6zm6.8-.2a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0zM12 4.2c-2.5 0-2.8 0-3.8.1a5 5 0 0 0-1.7.3 3.4 3.4 0 0 0-2 2 5 5 0 0 0-.3 1.7c-.1 1-.1 1.3-.1 3.8s0 2.8.1 3.8a5 5 0 0 0 .3 1.7 3.4 3.4 0 0 0 2 2 5 5 0 0 0 1.7.3c1 .1 1.3.1 3.8.1s2.8 0 3.8-.1a5 5 0 0 0 1.7-.3 3.4 3.4 0 0 0 2-2 5 5 0 0 0 .3-1.7c.1-1 .1-1.3.1-3.8s0-2.8-.1-3.8a5 5 0 0 0-.3-1.7 3.4 3.4 0 0 0-2-2 5 5 0 0 0-1.7-.3c-1-.1-1.3-.1-3.8-.1z' },
  { label: 'X', href: '#', path: 'M17.8 4h2.7l-6 6.8L21.5 20h-5.6l-4.3-5.6L6.6 20H3.9l6.4-7.3L3.6 4H9l3.9 5.1L17.8 4zm-1 14.3h1.5L8.1 5.5H6.5l10.3 12.8z' },
];
---
<footer class="footer">
  <div class="footer__top">
    <p class="footer__big">{t.footer.title}</p>
    <a class="footer__hire" href="#contact">
      <span>{t.footer.hireMe}</span>
      <svg width="42" height="42" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>

  <hr class="footer__line" />

  <div class="footer__cols">
    <div class="footer__brand">
      <a class="footer__logo" href={localizedUrl(lang, '/')} aria-label="BRYANDEV — home">
        <span class="footer__badge" aria-hidden="true">B</span>
        <span class="footer__wordmark">BRYANDEV</span>
      </a>
      <div class="footer__socials">
        {socials.map((s) => (
          <a class="footer__social" href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined} aria-label={s.label}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <p class="footer__head">{t.footer.navTitle}</p>
      {t.footer.nav.map((l) => (
        <a class="footer__link" href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="footer__contact">
      <p class="footer__head">{t.footer.contactTitle}</p>
      <a class="footer__link" href={`tel:${t.footer.phone.replace(/\s/g, '')}`}>{t.footer.phone}</a>
      <a class="footer__link" href={`mailto:${t.footer.email}`}>{t.footer.email}</a>
    </div>

    <div class="footer__news">
      <p class="footer__head">{t.footer.newsTitle}</p>
      {/* DETAILS LATER: newsletter provider wiring */}
      <form class="footer__form" data-news-form>
        <label class="footer__sr">{t.footer.newsPlaceholder}</label>
        <input class="footer__input" type="email" name="email" required placeholder={t.footer.newsPlaceholder} autocomplete="email" />
        <button class="footer__send" type="submit" aria-label={t.footer.newsSend}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 11l18-7-7 18-2.5-7.5L3 11z" fill="#fcfcfd"/></svg>
        </button>
      </form>
    </div>
  </div>

  <hr class="footer__line" />

  <div class="footer__bottom">
    <p class="footer__rights">{t.footer.rights}</p>
  </div>
</footer>

<style>
  /* Figma Frame 326 Footer — layout pass (social URLs + newsletter wiring later). */
  .footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.625rem; /* 10px */
    min-height: 42.8125rem; /* 685px Figma */
    padding: 1.5625rem 4.4375rem; /* 25px 71px */
    background: #171717;
    border-radius: 24px 24px 0 0;
  }
  /* Top row — 1298px, space-between center */
  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    width: min(100%, 81.125rem); /* 1298px */
    margin-inline: auto;
  }
  .footer__big {
    margin: 0;
    max-width: 40.1875rem; /* 643px */
    font-family: var(--font-bungee);
    font-size: 4rem; /* 64px */
    line-height: 1.2; /* 77px */
    letter-spacing: -0.015em;
    color: #fcfcfd;
  }
  /* Hire me pill 202x62, purple, radius 60 */
  .footer__hire {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
    padding: 0.625rem 1.25rem;
    min-width: 12.625rem; /* 202px */
    min-height: 3.875rem; /* 62px */
    box-sizing: border-box;
    border-radius: 60px;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-bungee);
    font-size: 1.6069rem; /* 25.69px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }
  .footer__line {
    width: min(100%, 81.125rem);
    margin: 0 auto;
    border: none;
    border-top: 2px solid #475467; /* Gray/600 */
  }
  /* Middle columns — 1298px, space-between */
  .footer__cols {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    width: min(100%, 81.125rem);
    margin-inline: auto;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.8125rem; /* 29px */
    min-height: 14.9375rem; /* 239px */
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 2.5rem;
    border-radius: 60px;
    color: #fff;
    text-decoration: none;
  }
  .footer__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.875rem;
    height: 2.875rem;
    border-radius: 50px;
    background: var(--color-primary);
    font-family: var(--font-inter);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
  }
  .footer__wordmark {
    font-family: var(--font-inter);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    white-space: nowrap;
  }
  .footer__socials {
    display: flex;
    gap: 0.3125rem; /* 5px */
  }
  .footer__social {
    display: inline-flex;
    padding: 0.25rem;
    border-radius: 8px;
  }
  .footer__social:hover { background: rgba(255, 255, 255, 0.1); }
  /* Link columns */
  .footer__nav, .footer__contact, .footer__news {
    display: flex;
    flex-direction: column;
    gap: 1.75rem; /* 28px */
  }
  .footer__head {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 1.25rem; /* 20px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }
  .footer__nav .footer__link, .footer__contact .footer__link {
    font-size: 1rem; /* 16px */
  }
  .footer__link {
    color: #fcfcfd;
    font-family: var(--font-bungee);
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  .footer__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .footer__contact { gap: 1.25rem; }
  .footer__contact .footer__head { margin-bottom: 0.5rem; }
  /* Newsletter row — input 258px + purple send 46px */
  .footer__form { display: flex; }
  .footer__sr {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .footer__input {
    width: 16.125rem; /* 258px */
    height: 3.1875rem; /* 51px */
    padding: 0.8125rem 0.875rem; /* 13px 14px */
    box-sizing: border-box;
    border: none;
    outline: none;
    border-radius: 14px 0 0 14px;
    background: #fff;
    color: #000;
    font-family: var(--font-bungee);
    font-size: 1rem;
  }
  .footer__input::placeholder { color: #000; opacity: 1; }
  .footer__send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.875rem; /* 46px */
    height: 3.1875rem;
    border: none;
    border-radius: 0 14px 14px 0;
    background: var(--color-primary);
    cursor: pointer;
  }
  /* Bottom bar */
  .footer__bottom {
    width: min(100%, 81.125rem);
    margin-inline: auto;
  }
  .footer__rights {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 1.25rem; /* 20px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
  }

  @media (max-width: 80rem) {
    .footer { min-height: 0; padding: 2rem 1.5rem; border-radius: 24px 24px 0 0; }
    .footer__top { flex-direction: column; align-items: flex-start; }
    .footer__big { font-size: 2.5rem; }
    .footer__cols { flex-direction: column; }
    .footer__brand { min-height: 0; }
  }
</style>
