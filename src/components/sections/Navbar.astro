---
import type { Lang } from '../../i18n/config';
import type { Dict } from '../../i18n/utils';
import { localizedUrl } from '../../i18n/utils';

interface Props { lang: Lang; t: Dict; currentPath: string; }
const { lang, t } = Astro.props;

const leftLinks = [
  { href: '#home', label: t.nav.home, active: true },
  { href: '#about', label: t.nav.about, active: false },
  { href: '#skills', label: t.nav.skills, active: false },
];
const rightLinks = [
  { href: '#projects', label: t.nav.projects, active: false },
  { href: '#experience', label: t.nav.experience, active: false },
  { href: '#contact', label: t.nav.contact, active: false },
];
---
<header class="navbar">
  <nav class="navbar__pill" aria-label="Primary">
    <div class="navbar__group">
      {leftLinks.map((l) => (
        <a href={l.href} class:list={['navbar__link', { 'navbar__link--active': l.active }]} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <a class="navbar__brand" href={localizedUrl(lang, '/')} aria-label="BRYANDEV — home">
      <span class="navbar__badge" aria-hidden="true">B</span>
      <span class="navbar__wordmark">BRYANDEV</span>
    </a>
    <div class="navbar__group navbar__group--right">
      {rightLinks.map((l) => (
        <a href={l.href} class="navbar__link">{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  /* Figma Frame 1 — dark pill nav. Fluid (no 1298px fixed) for responsiveness. */
  .navbar {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    display: flex;
    justify-content: center;
    margin-inline: 2.5rem;
    background: transparent;
  }
  .navbar__pill {
    width: min(100%, 81.125rem); /* 1298px */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem 0.5rem 0.5rem; /* compact: breathing room right, tight left */
    min-height: 4.5rem;
    background: var(--color-ink);
    border-radius: 50px;
    backdrop-filter: blur(7.5px);
    -webkit-backdrop-filter: blur(7.5px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .navbar__pill::-webkit-scrollbar { display: none; }
  .navbar__group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }
  /* Right group gets a wider rhythm. */
  .navbar__group--right { gap: 0.75rem; padding-right: 0.5rem; }
  /* Figma: default link Bungee 20px white, pill radius 60 — compacted to fit 7 items + switcher */
  .navbar__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border-radius: 60px;
    font-family: var(--font-bungee);
    font-size: 1.0625rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }
  .navbar__link:hover { background: rgba(255, 255, 255, 0.08); }
  /* Figma Frame 7 — active link purple, Lufga 700 */
  .navbar__link--active {
    background: var(--color-primary);
    font-family: var(--font-lufga);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  /* Figma Frame 14 — logo: purple circle B + BRYANDEV */
  .navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    border-radius: 60px;
    color: #fff;
    text-decoration: none;
    flex-shrink: 0;
  }
  .navbar__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50px;
    background: var(--color-primary);
    font-family: var(--font-inter);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
  }
  .navbar__wordmark {
    font-family: var(--font-inter);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.2;
    white-space: nowrap;
  }
  @media (max-width: 64rem) {
    .navbar { margin-inline: 1rem; }
    .navbar__link, .navbar__brand { padding: 0.875rem 1.25rem; font-size: 1rem; }
    .navbar__wordmark { font-size: 1.125rem; }
    .navbar__badge { width: 2.25rem; height: 2.25rem; font-size: 1.125rem; }
  }
</style>
