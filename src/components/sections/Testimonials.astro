---
import type { Dict } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props { lang: Lang; t: Dict; }
const { t } = Astro.props;
const items = t.testimonials.items;
---
<section class="testi" id="testimonials" aria-labelledby="testi-title">
  <div class="testi__head">
    <h2 class="testi__title" id="testi-title">{t.testimonials.titlePrefix}<span class="testi__titleAccent">{t.testimonials.titleAccent}</span></h2>
    <p class="testi__desc">{t.testimonials.desc}</p>
    <svg class="testi__deco testi__deco--1" width="23" height="29" viewBox="0 0 23 29" fill="none" aria-hidden="true"><path d="M18.2918 5.6213L15.8226 6.43699L13.497 3.86495C12.2649 2.45128 10.6385 0.921409 9.89224 0.401308C7.92003 -0.973246 6.78964 1.33041 7.50378 5.07818L8.1051 8.19243L4.35792 8.91009C2.00523 9.33135 0.403742 10.0384 0.154617 10.7367C-0.317617 11.7551 0.0877393 12.1962 4.30362 14.8967L8.89261 17.8573L8.71545 20.2704C8.00059 29.3637 11.3215 31.7575 14.1152 24.1131L15.3025 20.8186L16.9115 21.4644C21.648 23.418 22.3298 23.576 22.8503 22.8291C23.1478 22.4023 22.3829 20.2045 21.1495 17.9973C18.5809 13.2741 18.5052 12.5872 20.3645 9.91961C23.1533 5.91815 22.4108 4.37011 18.2918 5.6213ZM11.8733 7.33091C11.6874 7.59767 11.3949 7.79014 11.2883 7.71584C11.1284 7.60439 11.0478 7.15187 11.0738 6.77366C11.137 6.34209 11.3923 6.20298 11.6589 6.38873C11.9787 6.61163 12.0965 7.01079 11.8733 7.33091ZM14.8411 11.9359C14.9539 12.5694 14.4395 13.8756 13.733 14.8893L12.3943 16.81L11.8786 13.9139C11.4434 11.4703 11.5971 11.0225 12.6668 10.7376C14.1729 10.2812 14.5832 10.4879 14.8411 11.9359ZM8.28381 13.3902C8.13012 13.838 7.46447 13.7704 6.61162 13.176C5.33235 12.2844 5.30012 12.1034 6.36985 11.8184C7.74823 11.4315 8.6172 12.1165 8.28381 13.3902Z" fill="#FCFCFD"/></svg>
    <svg class="testi__deco testi__deco--2" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><path d="M11.9808 2.04166L10.4215 4.1227L7.04297 3.34231C5.22377 2.88708 3.01473 2.56192 2.10512 2.56192C-0.298833 2.56192 0.090997 5.09819 2.81981 7.76452L5.09382 9.97563L2.42998 12.707C0.740714 14.3978 -0.16889 15.8936 0.0260252 16.6089C0.220941 17.7145 0.805686 17.8446 5.80851 17.6495L11.2661 17.4544L12.5006 19.5354C17.1136 27.4043 21.2068 27.4694 19.1277 19.6004L18.2181 16.2187L19.9074 15.8286C24.9102 14.723 25.5599 14.4629 25.5599 13.5524C25.5599 13.0322 23.6757 11.6665 21.4017 10.5609C16.5938 8.15472 16.139 7.63446 16.139 4.38283C16.139 -0.494608 14.6447 -1.34003 11.9808 2.04166ZM7.69269 7.1142C7.69269 7.43936 7.56275 7.76452 7.4328 7.76452C7.23789 7.76452 6.91303 7.43936 6.71812 7.1142C6.5232 6.724 6.65314 6.46387 6.978 6.46387C7.36783 6.46387 7.69269 6.724 7.69269 7.1142ZM12.7605 9.19524C13.2153 9.65047 13.5401 11.0161 13.5401 12.2518V14.5929L11.4611 12.5119C9.70682 10.756 9.57687 10.3008 10.2916 9.45537C11.2661 8.21975 11.7209 8.15472 12.7605 9.19524ZM8.21247 14.1377C8.34241 14.5929 7.75766 14.9181 6.71812 14.9181C5.15879 14.9181 5.02885 14.788 5.74354 13.9426C6.65314 12.8371 7.75766 12.9021 8.21247 14.1377Z" fill="#FCFCFD"/></svg>
  </div>

  {/* DETAILS LATER: carousel controls + real avatars/texts. Endless marquee for now. */}
  <div class="testi__viewport">
    <div class="testi__track">
      <div class="testi__set">
      {items.map((item) => (
        <article class="tcard">
          <div class="tcard__author">
            <span class="tcard__avatar" aria-hidden="true">{item.image ? (<img class="tcard__avatarImg" src={item.image} alt="" width="55" height="55" loading="lazy" decoding="async" />) : (item.name.charAt(0))}</span>
            <div class="tcard__who">
              <p class="tcard__name">{item.name}</p>
              <p class="tcard__role">{item.role}</p>
            </div>
          </div>
          <div class="tcard__rating">
            <span class="tcard__stars" role="img" aria-label={`${item.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <svg width="32" height="32" viewBox="0 0 24 24" fill={s < item.rating ? item.stars : 'rgba(255,255,255,0.25)'} aria-hidden="true"><path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.56l-5.9 3.1 1.13-6.57L2.45 9.44l6.6-.96L12 2.5z"/></svg>
              ))}
            </span>
            <span class="tcard__score">{item.rating.toFixed(1)}</span>
          </div>
          <p class="tcard__quote">{item.quote}</p>
          <svg class="tcard__bigquote" width="128" height="128" viewBox="0 0 128 128" fill="none" aria-hidden="true"><path d="M84.8534 65.9734H109.867C109.44 90.8801 104.533 94.9868 89.2267 104.053C87.4667 105.12 86.88 107.36 87.9467 109.173C89.0134 110.933 91.2534 111.52 93.0667 110.453C111.093 99.7868 117.387 93.2801 117.387 62.2401V33.4934C117.387 24.3734 109.973 17.0134 100.907 17.0134H84.9067C75.52 17.0134 68.4267 24.1068 68.4267 33.4934V49.4934C68.3734 58.8801 75.4667 65.9734 84.8534 65.9734Z" fill="#667085" fill-opacity="0.3"/><path d="M27.1466 65.9734H52.16C51.7333 90.8801 46.8266 94.9868 31.52 104.053C29.76 105.12 29.1733 107.36 30.24 109.173C31.3066 110.933 33.5466 111.52 35.36 110.453C53.3866 99.7868 59.68 93.2801 59.68 62.2401V33.4934C59.68 24.3734 52.2666 17.0134 43.2 17.0134H27.2C17.76 17.0134 10.6666 24.1068 10.6666 33.4934V49.4934C10.6666 58.8801 17.76 65.9734 27.1466 65.9734Z" fill="#667085" fill-opacity="0.3"/></svg>
        </article>
      ))}
      </div>
      <div class="testi__set testi__set--clone" aria-hidden="true">
      {items.map((item) => (
        <article class="tcard">
          <div class="tcard__author">
            <span class="tcard__avatar" aria-hidden="true">{item.image ? (<img class="tcard__avatarImg" src={item.image} alt="" width="55" height="55" loading="lazy" decoding="async" />) : (item.name.charAt(0))}</span>
            <div class="tcard__who">
              <p class="tcard__name">{item.name}</p>
              <p class="tcard__role">{item.role}</p>
            </div>
          </div>
          <div class="tcard__rating">
            <span class="tcard__stars" role="img" aria-label={`${item.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <svg width="32" height="32" viewBox="0 0 24 24" fill={s < item.rating ? item.stars : 'rgba(255,255,255,0.25)'} aria-hidden="true"><path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.56l-5.9 3.1 1.13-6.57L2.45 9.44l6.6-.96L12 2.5z"/></svg>
              ))}
            </span>
            <span class="tcard__score">{item.rating.toFixed(1)}</span>
          </div>
          <p class="tcard__quote">{item.quote}</p>
          <svg class="tcard__bigquote" width="128" height="128" viewBox="0 0 128 128" fill="none" aria-hidden="true"><path d="M84.8534 65.9734H109.867C109.44 90.8801 104.533 94.9868 89.2267 104.053C87.4667 105.12 86.88 107.36 87.9467 109.173C89.0134 110.933 91.2534 111.52 93.0667 110.453C111.093 99.7868 117.387 93.2801 117.387 62.2401V33.4934C117.387 24.3734 109.973 17.0134 100.907 17.0134H84.9067C75.52 17.0134 68.4267 24.1068 68.4267 33.4934V49.4934C68.3734 58.8801 75.4667 65.9734 84.8534 65.9734Z" fill="#667085" fill-opacity="0.3"/><path d="M27.1466 65.9734H52.16C51.7333 90.8801 46.8266 94.9868 31.52 104.053C29.76 105.12 29.1733 107.36 30.24 109.173C31.3066 110.933 33.5466 111.52 35.36 110.453C53.3866 99.7868 59.68 93.2801 59.68 62.2401V33.4934C59.68 24.3734 52.2666 17.0134 43.2 17.0134H27.2C17.76 17.0134 10.6666 24.1068 10.6666 33.4934V49.4934C10.6666 58.8801 17.76 65.9734 27.1466 65.9734Z" fill="#667085" fill-opacity="0.3"/></svg>
        </article>
      ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Figma Frame 77 Testimonials — layout pass (carousel JS + details later). */
  .testi {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6rem; /* 96px */
    padding: 7.25rem 4.4375rem; /* 116px 71px */
    background: #171717;
    border-radius: 50px;
  }
  /* Figma Frame 4 — header, column center, gap 14px */
  .testi__head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem; /* 14px */
    width: min(100%, 81.1875rem); /* 1299px */
  }
  /* Decorative header squiggles */
  .testi__deco { position: absolute; pointer-events: none; }
  .testi__deco--1 { left: 65%; top: -0.75rem; }
  .testi__deco--2 { left: 27%; top: calc(100% + 1.25rem); }
  .testi__title {
    margin: 0;
    max-width: 34.5625rem; /* 553px */
    font-family: var(--font-bungee);
    font-size: 3rem; /* 48px */
    line-height: 1.21; /* 58px */
    text-align: center;
    letter-spacing: -0.015em;
    color: #fcfcfd; /* Gray/25 */
  }
  .testi__titleAccent { color: var(--color-primary); }
  .testi__desc {
    margin: 0;
    max-width: 46.375rem; /* 742px */
    font-family: var(--font-bungee);
    font-size: 1.25rem; /* 20px */
    line-height: 1.2;
    text-align: center;
    letter-spacing: -0.015em;
    color: #f9fafb; /* Gray/50 */
  }
  /* Figma Frame 11 — 1299px viewport, overflow hidden, center card + side peeks */
  .testi__viewport {
    overflow: hidden;
    width: min(100%, 81.1875rem);
  }
  .testi__track {
    display: flex;
    width: max-content;
    animation: testi-marquee 36s linear infinite;
    will-change: transform;
  }
  .testi__set {
    display: flex;
    gap: 1.5rem; /* 24px */
    padding-right: 1.5rem;
  }
  /* One set period = 3x784 + 3x24 = 2424px = 151.5rem — seamless loop */
  @keyframes testi-marquee {
    from { transform: translateX(-34.4063rem); } /* -550.5px: 2nd card centered */
    to { transform: translateX(calc(-34.4063rem - 151.5rem)); }
  }
  .testi__viewport:hover .testi__track,
  .testi__viewport:focus-within .testi__track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .testi__track { animation: none; }
  }
  /* Figma Component 7/8/9 — card 784x263, glass white 14% + white border, radius 24 */
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem; /* 14px */
    width: 49rem; /* 784px */
    padding: 1.3125rem; /* 21px */
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.14);
  }
  .tcard__author {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem; /* 12px */
  }
  .tcard__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.4275rem; /* 54.84px */
    height: 3.4275rem;
    border-radius: 50%;
    background: #667085;
    color: #fff;
    font-family: var(--font-urbanist);
    font-weight: 700;
    font-size: 1.5rem;
    overflow: hidden;
  }
  .tcard__avatarImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tcard__who { display: flex; flex-direction: column; }
  .tcard__name {
    margin: 0;
    font-family: var(--font-urbanist);
    font-weight: 700;
    font-size: 1.4688rem; /* 23.5px */
    line-height: 1.2;
    color: #fcfcfd;
  }
  .tcard__role {
    margin: 0;
    font-family: var(--font-urbanist);
    font-size: 1.1424rem; /* 18.28px */
    line-height: 1.2;
    color: #fcfcfd;
  }
  .tcard__rating {
    display: flex;
    align-items: center;
    gap: 0.3125rem; /* 5px */
  }
  .tcard__stars { display: inline-flex; }
  .tcard__score {
    font-family: var(--font-bungee);
    font-size: 1.607rem; /* 25.69px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fcfcfd;
  }
  .tcard__quote {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #f9fafb;
  }
  .tcard__bigquote {
    position: absolute;
    right: 1.5rem;
    top: 0.75rem;
    width: 8rem;
    height: 8rem;
    pointer-events: none;
  }

  @media (max-width: 80rem) {
    .testi { padding: 4rem 1.5rem; gap: 3rem; border-radius: 32px; }
    .testi__title { font-size: 2.25rem; }
    .testi__deco { display: none; }
    .testi__track { flex-direction: column; width: 100%; animation: none; }
    .testi__set { flex-direction: column; padding-right: 0; }
    .testi__set--clone { display: none; }
    .tcard { width: 100%; }
  }
</style>
