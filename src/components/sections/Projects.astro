---
import type { Dict } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props { lang: Lang; t: Dict; }
const { t } = Astro.props;
const items = t.projects.items;
---
<section class="projects" id="projects" aria-labelledby="projects-title">
  <div class="projects__head">
    <h2 class="projects__title" id="projects-title">{t.projects.titlePrefix}<span class="projects__titleAccent">{t.projects.titleAccent}</span></h2>
    <p class="projects__desc">{t.projects.description}</p>
  </div>

  <div class="projects__cards">
    {items.map((item) => (
      <article class="pcard">
        <div class="pcard__label">
          <p class="pcard__tag">{item.tag}</p>
          <hr class="pcard__line" />
        </div>
        {/* Figma Frame 61 — stacked white sheets + linked project image */}
        <div class="pcard__thumb">
          <span class="pcard__sheet pcard__sheet--back" aria-hidden="true"></span>
          <span class="pcard__sheet pcard__sheet--mid" aria-hidden="true"></span>
          <a class="pcard__imgLink" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.name}>
            <img class="pcard__img" src={item.image} alt={item.name} width="416" height="306" loading="lazy" decoding="async" />
          </a>
        </div>
        <a class="pcard__arrow" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${item.name}`}>
          <svg width="72" height="72" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </article>
    ))}
  </div>

  <div class="projects__dots" aria-hidden="true">
    <span class="projects__dot projects__dot--active"></span>
    <span class="projects__dot"></span>
    <span class="projects__dot"></span>
    <span class="projects__dot"></span>
  </div>
</section>

<style>
  /* Figma Projects Section — layout pass (details later). */
  .projects {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6rem; /* 96px */
    padding: 7.25rem 4.4375rem; /* 116px 71px */
    background: #171717;
    border-radius: 50px;
  }
  /* Figma Frame 4 — header row 1299px, space-between, align flex-end */
  .projects__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    width: min(100%, 81.1875rem); /* 1299px */
  }
  .projects__title {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 3rem; /* 48px */
    line-height: 1;
    letter-spacing: -0.015em;
    color: #fff;
    white-space: nowrap;
  }
  .projects__titleAccent { color: var(--color-primary); }
  .projects__desc {
    margin: 0;
    max-width: 36rem; /* 576px */
    font-family: var(--font-bungee);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
  }
  /* Figma cards row — 3 x 416px, gap 45px */
  .projects__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 26rem)); /* 416px */
    gap: 2.8125rem; /* 45px */
    justify-content: center;
    width: min(100%, 81.1875rem);
  }
  /* Figma Frame 59/60 — card 416x508, #3C3C3C + glass overlay */
  .pcard {
    position: relative;
    aspect-ratio: 416 / 508;
    overflow: hidden;
    border-radius: 35px;
    background: #3c3c3c;
    isolation: isolate;
  }
  .pcard::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(104, 104, 104, 0.2);
    backdrop-filter: blur(7.5px);
    -webkit-backdrop-filter: blur(7.5px);
  }
  .pcard__label {
    position: relative;
    z-index: 1;
    padding: 2.75rem 2.3125rem 0; /* top 44px, sides 37px */
  }
  .pcard__tag {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 2rem; /* 32px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .pcard__line {
    margin: 1.4375rem 0 0; /* gap 23px */
    border: none;
    border-top: 2px solid rgba(249, 250, 251, 0.3);
  }
  /* Figma Frame 61 — 416x351 stack: white sheets behind, image 416x307 front */
  .pcard__thumb {
    position: relative;
    z-index: 1;
    aspect-ratio: 416 / 351;
    margin: 1.25rem 0 0;
  }
  .pcard__sheet {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 93.7%; /* 329/351 */
    border-radius: 35px;
    background: #fff;
  }
  .pcard__sheet--back { width: 78.8%; opacity: 0.5; } /* 328px */
  .pcard__sheet--mid { width: 89.9%; top: 3.1%; } /* 374px */
  .pcard__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 35px;
  }
  .pcard__imgLink {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 87.5%; /* 307/351 */
    border-radius: 35px;
  }
  /* Figma Frame 57 — 114px circle arrow, purple, right-bottom */
  .pcard__arrow {
    position: absolute;
    right: 0;
    top: 77.5%; /* 394/508 */
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 7.125rem; /* 114px */
    height: 7.125rem;
    border-radius: 50%;
    background: var(--color-primary);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .pcard__arrow:hover, .pcard__arrow:focus-visible {
    transform: translateY(-0.375rem);
    box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .pcard__arrow { transition: none; }
    .pcard__arrow:hover, .pcard__arrow:focus-visible { transform: none; }
  }
  /* Figma dots — active 60px purple pill + 15px gray dots */
  .projects__dots {
    display: flex;
    gap: 0.7069rem; /* 11.31px */
  }
  .projects__dot {
    width: 0.9425rem; /* 15.08px */
    height: 0.9425rem;
    border-radius: 20.7364px;
    background: #e4e7ec;
  }
  .projects__dot--active {
    width: 3.77rem; /* 60.32px */
    background: var(--color-primary);
  }

  @media (max-width: 80rem) {
    .projects { padding: 4rem 1.5rem; gap: 3rem; border-radius: 32px; }
    .projects__head { flex-direction: column; align-items: flex-start; }
    .projects__title { font-size: 2.25rem; white-space: normal; }
    .projects__cards { grid-template-columns: minmax(0, 26rem); }
  }
</style>
