---
import type { Dict } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props { lang: Lang; t: Dict; }
const { t } = Astro.props;
---
<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="hero__head">
    {/* Figma Group 3 — greeting pill + purple squiggle vector */}
    <div class="hero__badgeWrap">
      <p class="hero__greeting">{t.hero.greeting}</p>
      <svg class="hero__spark" width="32" height="33" viewBox="0 0 32 33" fill="none" aria-hidden="true"><path d="M2.00049 20.0005C2.00049 17.0005 5.00049 11.0005 2.00049 2.00055M9.50049 23.5005C13.8338 19.3339 22.7005 9.20055 23.5005 2.00055M12.5005 30.5005C15.1672 30.5005 22.3005 29.1005 29.5005 23.5005" stroke="#8224E3" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="hero__titleWrap">
      <h1 class="hero__title" id="hero-title">{t.hero.titlePrefix}<span class="hero__titleName">{t.hero.titleName}</span>{t.hero.titleComma}<br /><span class="hero__line2">{t.hero.titleRest}<svg class="hero__curl" width="74" height="85" viewBox="0 0 74 85" fill="none" aria-hidden="true"><path d="M70.7544 35.9953C69.0721 43.6553 58.0474 57.293 60.6604 81.9553M53.5672 22.8528C40.1662 31.0617 11.8441 51.9632 5.7638 69.8985M49.8327 3.29718C43.0238 1.80177 24.0249 1.3762 2.50059 11.6372" stroke="#8224E3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h1>
    </div>
  </div>

  <div class="hero__grid">
    <aside class="hero__quote">
      {/* Figma vuesax/bold/quote-up 36px, Gray/700 */}
      <svg class="hero__qmark" width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M15.3 10.8c-4.5 2.4-7.5 6.6-7.5 12v2.4c0 1.2 1.2 2.4 2.4 2.4h2.4c1.2 0 2.4-1.2 2.4-2.4v-2.4c0-1.2-1.2-2.4-2.4-2.4h-.6c.6-2.4 2.4-4.2 4.5-5.4l-1.2-4.2zm12 0c-4.5 2.4-7.5 6.6-7.5 12v2.4c0 1.2 1.2 2.4 2.4 2.4h2.4c1.2 0 2.4-1.2 2.4-2.4v-2.4c0-1.2-1.2-2.4-2.4-2.4h-.6c.6-2.4 2.4-4.2 4.5-5.4l-1.2-4.2z" fill="#344054"/></svg>
      <p>{t.hero.quote}</p>
    </aside>

    <figure class="hero__media">
      {/* Figma Ellipse 2 — half-dome backdrop */}
      <svg class="hero__ellipse" width="812" height="406" viewBox="0 0 812 406" fill="none" aria-hidden="true"><path d="M811.779 405.889C541.186 405.889 270.593 405.889 0 405.889C0 181.723 181.723 0 405.889 0C630.056 0 811.779 181.723 811.779 405.889Z" fill="#496D8F"/></svg>
      {/* Drop your Figma export as public/hero-portrait.png (bryan-removebg-preview.png renamed). 952x636 recommended. */}
      <img
        class="hero__img"
        src="/hero-portrait.png"
        alt={`${t.hero.titlePrefix}${t.hero.titleName}${t.hero.titleComma} ${t.hero.titleRest}`}
        width="952"
        height="636"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="hero__cta">
        <a class="hero__btn hero__btn--portfolio" href="#projects">
          <span>{t.hero.portfolio}</span>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="hero__btn hero__btn--hire" href="#contact">{t.hero.hireMe}</a>
      </figcaption>
    </figure>

    <aside class="hero__stats">
      <div class="hero__stars" role="img" aria-label="5 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.56l-5.9 3.1 1.13-6.57L2.45 9.44l6.6-.96L12 2.5z"/></svg>
        ))}
      </div>
      <div class="hero__yearsGroup">
        <p class="hero__years">{t.hero.yearsNumber}</p>
        <p class="hero__yearsLabel">{t.hero.yearsLabel}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* Figma Hero Section — fluid reinterpretation (no 1440px fixed, no absolute soup). */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0.5rem 0 2rem;
  }
  .hero__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 57.0625rem; /* 913px */
    margin-top: 1.25rem;
    text-align: center;
  }
  /* Figma Group 3 — 139.99x64 wrapper; pill + vector positioned inside. */
  .hero__badgeWrap {
    position: relative;
    width: 8.7494rem; /* 139.99px */
    height: 4rem; /* 64px */
  }
  /* Figma Frame 7 — Hello pill */
  .hero__greeting {
    position: absolute;
    left: calc(50% - 8.0613rem/2 - 0.3438rem);
    top: 1.1875rem; /* 19px */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3981rem; /* 6.37px */
    width: 8.0613rem; /* 128.98px */
    height: 2.8125rem; /* 45px */
    margin: 0;
    padding: 0.7966rem 1.5931rem; /* 12.7451px 25.4902px */
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.1);
    border: 1.27451px solid var(--color-ink);
    border-radius: 38.2353px;
    font-family: var(--font-bungee);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  /* Figma Vector 1 — purple squiggle, top-right of the badge. */
  .hero__spark {
    position: absolute;
    top: 0;
    right: -0.5rem;
    width: 2rem;
    height: 2.0625rem;
  }
  /* Figma — headline overlaps portrait (Frame 5 over Frame 57) */
  .hero__titleWrap {
    position: relative;
    z-index: 2;
    margin-top: 0.625rem;
    margin-bottom: -4.5rem;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-urbanist);
    font-weight: 600;
    font-size: clamp(2.75rem, 6.64vw, 5.9727rem); /* 44px → 95.5px */
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .hero__titleName { color: var(--color-primary); }
  /* Second headline line anchors the curl vector below its first letters (SOF / ING). */
  .hero__line2 {
    position: relative;
    display: inline-block;
  }
  .hero__curl {
    position: absolute;
    right: calc(100% + 0.4rem);
    top: 56%;
    transform: translateY(-50%);
    width: 4.25rem;
    height: 4.9rem;
  }
  /* Figma Frame 67 — overlapped composition: portrait centered at full
     952px, quote/stats absolute over the sides (Figma itself overlaps them). */
  .hero__grid {
    position: relative;
    width: 100%;
    margin-top: 0;
  }
  /* Figma Frame 4 — left quote, uppercase */
  .hero__quote {
    position: absolute;
    left: 4.4375rem; /* 71px */
    bottom: 52%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 23.1875rem;
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-slate);
    text-transform: uppercase;
  }
  .hero__qmark {
    width: 2.25rem; /* 36px */
    height: 2.25rem;
    flex-shrink: 0;
  }
  /* Figma Frame 57 — 952.4x636 portrait block, centered */
  .hero__media {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 59.525rem); /* 952.4px */
    margin: 0 auto;
    isolation: isolate;
  }
  /* Figma Ellipse 2 — 811.78x405.89 at left 83.1 / top 230.11 */
  .hero__ellipse {
    position: absolute;
    left: 8.73%;
    top: 36.18%;
    width: 85.24%;
    height: auto;
    z-index: 0;
  }
  .hero__img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 952.4 / 636;
    object-fit: cover;
  }
  /* Figma Frame 56 — CTA bar, absolute bottom 43px */
  .hero__cta {
    position: absolute;
    left: 50%;
    bottom: 2.6875rem; /* 43px */
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: max-content;
    max-width: 92%;
    padding: 0.625rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.625rem 1.25rem;
    min-height: 3.875rem; /* 62px */
    border-radius: 60px;
    text-decoration: none;
    font-size: 1.6069rem; /* 25.69px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  /* Figma Frame 30 — Portfolio 208x62 purple */
  .hero__btn--portfolio {
    min-width: 13rem; /* 208px */
    background: var(--color-primary);
    border: 0.5px solid var(--color-pill-border);
    color: #fff;
    font-family: var(--font-bungee);
  }
  /* Figma Frame 31 — Hire me 129x54 Lufga light */
  .hero__btn--hire {
    min-width: 8.0625rem; /* 129px */
    min-height: 3.375rem; /* 54px */
    color: #fff;
    font-family: var(--font-lufga);
    font-weight: 300;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }
  /* Figma Frame 3 — right stats 160px at right 80px, gap 21, text centered */
  .hero__stats {
    position: absolute;
    right: 5rem; /* 80px */
    bottom: 51%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.3125rem; /* 21px */
    width: 10rem; /* 160px */
    text-align: center;
  }
  .hero__stars {
    display: flex;
    gap: 0;
    color: var(--color-primary);
  }
  /* Figma inner Frame 3 — number + label nested with 5px gap */
  .hero__yearsGroup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3125rem; /* 5px */
    width: 100%;
  }
  .hero__years {
    width: 100%;
    font-family: var(--font-urbanist);
    font-weight: 700;
    font-size: 2.9375rem; /* 47px */
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .hero__yearsLabel {
    width: 100%;
    font-family: var(--font-bungee);
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  /* Overlap composition needs room — stack below 1280px. */
  @media (max-width: 80rem) {
    .hero__titleWrap { margin-bottom: 0; }
    .hero__quote { position: static; align-items: center; max-width: 32rem; margin-inline: auto; text-align: center; }
    .hero__stats { position: static; align-items: center; margin-inline: auto; }
    .hero__media { width: 100%; max-width: 59.525rem; }
    .hero__cta { position: relative; left: auto; bottom: auto; transform: none; margin-top: -2.5rem; }
  }
  @media (max-width: 64rem) {
    .hero { width: 100%; }
    .hero__curl { width: 3.5rem; height: 4rem; }
    .hero__btn { font-size: 1.125rem; min-height: 3.25rem; }
  }
</style>
