---
import type { Dict } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props { lang: Lang; t: Dict; }
const { t } = Astro.props;
const items = t.skills.items;
---
<section class="skills" id="skills" aria-labelledby="skills-title">
  <div class="skills__head">
    <h2 class="skills__title" id="skills-title">{t.skills.titlePrefix}<span class="skills__titleAccent">{t.skills.titleAccent}</span></h2>
  </div>

  <div class="skills__grid">
    {items.map((item, i) => (
      <article class="skill">
        <span class="skill__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <p class="skill__name">{item.name}</p>
      </article>
    ))}
  </div>
</section>

<style>
  /* Skills — dark card matching Projects/Testimonials pattern. */
  .skills {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem; /* 64px */
    padding: 7.25rem 4.4375rem; /* 116px 71px */
    background: #171717;
    border-radius: 50px;
  }
  .skills__head {
    width: min(100%, 81.1875rem); /* 1299px */
  }
  .skills__title {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 3rem; /* 48px */
    line-height: 1;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .skills__titleAccent { color: var(--color-primary); }
  /* 3 x 2 glass cards */
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    width: min(100%, 81.1875rem);
  }
  .skill {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.14);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .skill:hover {
    transform: translateY(-0.375rem);
    box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.35);
  }
  .skill__index {
    font-family: var(--font-bungee);
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }
  .skill__name {
    margin: 0;
    font-family: var(--font-bungee);
    font-size: 1.75rem; /* 28px */
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .skill { transition: none; }
    .skill:hover { transform: none; }
  }

  @media (max-width: 80rem) {
    .skills { padding: 4rem 1.5rem; gap: 2.5rem; border-radius: 32px; }
    .skills__title { font-size: 2.25rem; }
    .skills__grid { grid-template-columns: minmax(0, 1fr); }
    .skill__name { font-size: 1.5rem; }
  }
</style>
