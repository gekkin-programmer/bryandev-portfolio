---
/**
 * LangScript — inline, runs BEFORE first paint.
 * Priority on load:
 *   1. localStorage('portfolio-lang') if en/fr
 *   2. navigator.language (fr-* -> fr, else en)
 *   3. default 'en'
 * Behaviour:
 *   - Always sets <html lang="..."> to avoid wrong-lang flash
 *   - Only redirects when on root "/" (preserves ?query and #hash)
 *   - Exposes window.__setLangPreference(lang) for the switcher
 */
import { STORAGE_KEY, DEFAULT_LANG } from '../i18n/config';
---
<script is:inline define:vars={{ STORAGE_KEY, DEFAULT_LANG }}>
  (function () {
    try {
      var KEY = STORAGE_KEY || 'portfolio-lang';
      var DEF = DEFAULT_LANG || 'en';
      function coerce(v) {
        if (v === 'en' || v === 'fr') return v;
        if (typeof v === 'string') {
          var l = v.toLowerCase();
          if (l.indexOf('fr') === 0) return 'fr';
          if (l.indexOf('en') === 0) return 'en';
        }
        return null;
      }
      var stored = null;
      try { stored = window.localStorage.getItem(KEY); } catch (e) {}
      var nav = coerce(window.navigator.language || (window.navigator).userLanguage);
      var lang = coerce(stored) || nav || DEF;
      document.documentElement.setAttribute('lang', lang);
      window.__currentLang = lang;
      window.__setLangPreference = function (next) {
        if (next !== 'en' && next !== 'fr') return;
        try { window.localStorage.setItem(KEY, next); } catch (e) {}
        document.documentElement.setAttribute('lang', next);
      };
      // Redirect ONLY from root "/" -> "/en/" or "/fr/"
      var path = window.location.pathname;
      if (path === '/' || path === '') {
        var target = '/' + lang + '/' + window.location.search + window.location.hash;
        window.location.replace(target);
      }
    } catch (e) {}
  })();
</script>
