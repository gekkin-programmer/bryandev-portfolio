---
/**
 * Root "/" — no content, instant redirect via LangScript (<head> inline script).
 * Fallback meta-refresh + links for no-JS / crawlers (SEO safe).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import LangScript from '../components/LangScript.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="fr" href="/fr/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <LangScript />
  </head>
  <body>
    <p style="font-family: system-ui; padding: 2rem;">
      <a href="/en/">English</a> · <a href="/fr/">Français</a>
    </p>
  </body>
</html>
