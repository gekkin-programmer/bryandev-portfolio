---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Hero from '../../components/sections/Hero.astro';
import Projects from '../../components/sections/Projects.astro';
import Experience from '../../components/sections/Experience.astro';
import WhyMe from '../../components/sections/WhyMe.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/sections/Footer.astro';
import { LANGUAGES, type Lang } from '../../i18n/config';
import { getDict } from '../../i18n/utils';
import { coerceLang } from '../../i18n/config';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const raw = Astro.params.lang;
const lang: Lang = coerceLang(raw);
const t = getDict(lang);
const currentPath = `/${lang}/`;
const path = currentPath;
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} path={path}>
  <Navbar lang={lang} t={t} currentPath={currentPath} />
  <main id="main">
    <Hero lang={lang} t={t} />
    <Projects lang={lang} t={t} />
    <Experience lang={lang} t={t} />
    <WhyMe lang={lang} t={t} />
    <Testimonials lang={lang} t={t} />
    <Contact lang={lang} t={t} />
  </main>
  <Footer lang={lang} t={t} />
</BaseLayout>
